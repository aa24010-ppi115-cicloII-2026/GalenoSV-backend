<?xml version="1.0" encoding="UTF-8"?>
<server description="Servidor OpenLiberty para GalenoSV">
    <featureManager>
        <feature>webProfile-11.0</feature>
    </featureManager>

    <httpEndpoint id="defaultHttpEndpoint"
                  host="*"
                  httpPort="9080"
                  httpsPort="9443"/>

    <!-- Dependencias declaradas como provided en pom.xml -->
    <library id="global">
        <fileset dir="${wlp.install.dir}/lib"
                 includes="primefaces-15.0.17-jakarta.jar,openpdf-1.3.30.jar"/>
    </library>

    <!-- Driver JDBC de PostgreSQL -->
    <library id="PostgresLib">
        <fileset dir="${shared.resource.dir}/postgresql" includes="postgresql-*.jar"/>
    </library>

    <!-- Pool de conexiones JTA configurado mediante variables de entorno -->
    <dataSource id="GalenoSVDS" jndiName="jdbc/GalenoSV">
        <jdbcDriver libraryRef="PostgresLib"/>
        <properties.postgresql
            serverName="${env.PG_HOST}"
            portNumber="${env.PG_PORT}"
            databaseName="${env.PG_DB}"
            user="${env.PG_USER}"
            password="${env.PG_PASS}"/>
        <connectionManager maxPoolSize="20" minPoolSize="2"/>
    </dataSource>

    <applicationManager autoExpand="true"/>
    <applicationMonitor updateTrigger="polled" dropinsEnabled="true"/>
</server>
